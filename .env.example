# Copy to .env and edit. Every setting is optional; the defaults run fully offline.

# fake (offline heuristic), jev (TypeSafe API) or laya (self-hosted, same protocol)
TRIAGE_BACKEND=fake

# Required for TRIAGE_BACKEND=jev: a key from https://console.typesafe.ai/ ...
# TYPESAFE_API_KEY=
# ... or an OpenRouter key, with these two lines uncommented:
# TRIAGE_JEV_BASE_URL=https://openrouter.ai/api
# TRIAGE_MODEL=typesafe/jev-1.13

# Benchmark only (triage-bench), for the LLMs. Not needed when Jev already goes through OpenRouter above.
# OPENROUTER_API_KEY=

# Required for TRIAGE_BACKEND=laya: your laya-serve URL, plus its LAYA_API_KEY if it has one.
# TRIAGE_LAYA_BASE_URL=http://localhost:8080
# TRIAGE_LAYA_API_KEY=

# cost: automate when the expected cost of a mistake is at most REVIEW_COST; above ESCALATE_COST a person
# handles the ticket. threshold: automate when every answer is at least AUTO_THRESHOLD certain.
TRIAGE_ROUTING=cost
TRIAGE_REVIEW_COST=2.0
TRIAGE_ESCALATE_COST=10.0
TRIAGE_AUTO_THRESHOLD=0.85
TRIAGE_REVIEW_THRESHOLD=0.60

# Share of automated tickets also sent to the review queue, to measure how accurate automation is.
TRIAGE_AUDIT_RATE=0.05

# TRIAGE_MODEL=jev-latest
# TRIAGE_REQUEST_TIMEOUT=5
# TRIAGE_DATABASE_URL=sqlite+aiosqlite:///./triage.db
